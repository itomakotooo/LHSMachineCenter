# OS
desktop.ini
Thumbs.db

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/

# Runtime logs/temp
*.log
*.tmp

# Local runtime state (not versioned)
state/catalog.db
state/*.db
state/*.sqlite
state/*.sqlite3
state/console/*
!state/console/.gitkeep
state/locks/*
!state/locks/.gitkeep

# Chunk cache (temporary, bounded)
cache/chunks/*
!cache/chunks/.gitkeep

# Legacy temporary outputs
fresh_slotlab/runs/
fresh_slotlab/__pycache__/

# Local Claude Code tooling state (launch.json, plans, etc.)
.claude/

# Dev rawdata (large, regenerable via batch_dev_sampler)
dev_rawdata/

# Probe snapshots (MachineConfigMd5 dumps, server snapshots)
.probe/

# Reports are generated data; only keep M14 as baseline reference.
reports/*
!reports/M14/
!reports/.gitkeep
# Ignore devcache report versions (regenerable from dev_rawdata).
reports/*/*/versions/*_devcache/
