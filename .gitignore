# OS
desktop.ini
Thumbs.db

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/

# Runtime logs/temp
*.log
*.tmp

# Local runtime state (not versioned)
state/catalog.db
state/*.db
state/*.sqlite
state/*.sqlite3
state/console/*
!state/console/.gitkeep
state/locks/*
!state/locks/.gitkeep

# Chunk cache (temporary, bounded)
cache/chunks/*
!cache/chunks/.gitkeep

# Legacy temporary outputs
fresh_slotlab/runs/
fresh_slotlab/__pycache__/

# Local Claude Code tooling state (launch.json, plans, etc.)
.claude/

# Rawdata (large, regenerable via batch_dev_sampler; prod deploys can
# point SLOT_RAWDATA_ROOT at a non-repo path, but the default lives
# here — always gitignored regardless). ``dev_rawdata/`` kept for
# back-compat on older checkouts that haven't re-pulled the rename yet.
rawdata/
dev_rawdata/

# Dev-generated reports (regenerable via batch_generate_reports from rawdata).
# Production reports go to reports/ only.
dev_reports/

# Probe snapshots (MachineConfigMd5 dumps, server snapshots)
.probe/

# Reports are generated data; only keep M14 as baseline reference.
# Dev-generated reports (batch_generate_reports) go to dev_reports/ instead.
reports/*
!reports/M14/
!reports/.gitkeep
# Even within M14, ignore devcache-suffixed and new mode dirs (they're imports
# from dev_reports, not canonical baseline — the original M14 mode_1 tracked
# versions remain in git).
reports/M14/mode_1/versions/*_devcache/
reports/M14/mode_2/
reports/M14/mode_5/
reports/M14/mode_7/
state/probes/
dev_reports/_classify/

# Paused WIP — paytable inference outputs (2026-04-18)
configs/paytables/

# Per-server hall mapping (refreshed via POST /api/machines/halls/refresh).
# Contents differ across dev/prod environments; not versioned.
configs/machine_halls.json

# Per-fleet static attributes cache (category / features / mechanics /
# md5). Bootstrapped from reports + machines.json on first access;
# auto-refreshed on every generate-report. Not versioned.
configs/machines_static.json

# Per-fleet rawdata lock registry — operator-applied carve-outs to
# protect specific (machine, mode) chunks from disk-pressure
# auto-cleanup. Not versioned (operator preference, not config).
configs/rawdata_locks.json

# slot_designer sim outputs (rawdata-format chunks, regenerable)
slot_designer/out/

# slot_designer virtual console state / data (regenerable / per-operator)
slot_designer/rawdata/
slot_designer/reports/
slot_designer/state/
slot_designer/cache_chunks/
slot_designer/dev_reports/
slot_designer/configs/paytables_virtual/
# Per-fleet static attrs cache — auto-rebuilt from reports + machines_virtual.json
slot_designer/configs/machines_static.json
