{
  "machine": "M43",
  "mode": 1,
  "schema_version": 2,

  "grid": {
    "cols": 3,
    "rows": 3,
    "paylines": [
      {
        "line_id": 1,
        "positions": [[0, 1], [1, 1], [2, 1]]
      }
    ]
  },

  "symbols": {
    "blank":     { "kind": "filler" },
    "1bar":      { "kind": "regular" },
    "2bar":      { "kind": "regular" },
    "3bar":      { "kind": "regular" },
    "7":         { "kind": "regular" },
    "wild":      { "kind": "wild", "multiplier": 2 },
    "blankup":   { "kind": "wild", "multiplier": 1 },
    "blankdown": { "kind": "wild", "multiplier": 1 }
  },

  "pays": [
    { "pay_id": 2,  "kind": "pure_wild", "multiset": { "wild": 3 }, "multiplier": 80 },
    { "pay_id": 3,  "kind": "line_3_same", "symbol": "7",    "multiplier": 60 },
    { "pay_id": 4,  "kind": "line_3_same", "symbol": "3bar", "multiplier": 40 },
    { "pay_id": 5,  "kind": "line_3_same", "symbol": "2bar", "multiplier": 20 },
    { "pay_id": 6,  "kind": "line_3_same", "symbol": "1bar", "multiplier": 10 },
    { "pay_id": 7,  "kind": "line_3_group", "group": ["1bar", "2bar", "3bar"], "multiplier": 5 },
    { "pay_id": 9,  "kind": "side_wild_alone", "multiplier": 2 },
    {
      "pay_id": 8,
      "kind": "plugin_handled",
      "family": "wild_blank_special",
      "_trigger_note": "payline has exactly 2 wild-family (wild/blankup/blankdown) + 1 plain blank",
      "_multiplier_note": "5 * 2^(window_wf_count - 4) * bet; window_wf_count in {4,5,6}",
      "_source": "01c_supp_pay_id_8.md §5 predicate B_v2 + §8 multiplier — HIGH confidence"
    }
  ],

  "evaluation_order": [
    "pure_wild",
    "line_3_same",
    "line_3_group",
    "side_wild_alone"
  ],

  "spin_types": {
    "1": {
      "kind": "paid",
      "cost_per_spin": 1000,
      "bet_amount": 1000,
      "reel_set": "default"
    }
  },

  "features": [
    {
      "name": "RespinAndMiniGame",
      "trigger": "post-win probabilistic (respin) + post-spin probabilistic (mini-game)",
      "trigger_pay_id": null,
      "rtp_scope": "separate"
    }
  ],

  "emit_fields": {
    "extra_round_fields": {
      "_default_reel_skin": 1
    }
  }
}
